# PostgreSQL Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=timetable_db

# Database Connection String
DATABASE_URL=postgresql+psycopg2://your_db_user:your_db_password@127.0.0.1:5432/timetable_db

# Security & Authentication
SECRET_KEY=generate_a_random_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Settings
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & Third-Party APIs
GEMINI_API_KEY=your_gemini_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=NexusSchedule
APP_URL=http://localhost:5173